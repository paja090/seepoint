# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seepoint?schema=public"
APP_URL="http://localhost:3000"

# Required by `prisma db seed` to create/update the first admin.
# Never use a fixed default password in production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="SeePoint Admin"

# Recommended production e-mail provider for invitations and password resets.
RESEND_API_KEY=""
EMAIL_FROM="SeePoint <noreply@example.com>"

# Optional legacy webhook alternative to Resend.
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""

# Google Maps API Configuration
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
GOOGLE_MAPS_SERVER_API_KEY=""
GOOGLE_MAPS_URL_SIGNING_SECRET=""

# Optional future storage token for Vercel Blob / object storage uploads.
BLOB_READ_WRITE_TOKEN=""

# Google Drive API configuration
# Enabled Google Drive mock mode (only for non-production environments)
GOOGLE_DRIVE_MOCK_ENABLED="false"
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""
