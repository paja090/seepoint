# ==============================================================================
# SeePoint OS – Environment Variables Configuration Template
# ==============================================================================
# Kopírujte do .env.local pro lokální vývoj nebo doplňte do Vercel Environment Variables.
# NIKDY sem nevkládejte skutečné produkční secrets ani hesla.

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# Primární připojovací řetězec PostgreSQL pro Prisma ORM.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seepoint?schema=public"

# Volitelné Vercel Postgres / Neon pooler proměnné (automaticky použity jako fallback, pokud chybí DATABASE_URL).
# POSTGRES_PRISMA_URL="postgresql://..."
# POSTGRES_URL_NON_POOLING="postgresql://..."
# POSTGRES_URL="postgresql://..."

# ------------------------------------------------------------------------------
# 2. APPLICATION BASE URL
# ------------------------------------------------------------------------------
# Kanonická veřejná adresa aplikace (např. https://seepoint.vercel.app nebo https://seepoint.cz).
# Používá se pro absolutní odkazy v e-mailech a OAuth přesměrování.
APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. EMAIL & RESEND
# ------------------------------------------------------------------------------
# Globální Resend API klíč pro odesílání e-mailů a správu klientských domén.
RESEND_API_KEY=""

# Výchozí odesílatel zpráv. Může obsahovat plné jméno "SeePOINT <info@seepoint.cz>" nebo jen e-mail.
EMAIL_FROM="SeePOINT <info@seepoint.cz>"

# Volitelné jméno odesílatele – použije se pouze tehdy, pokud EMAIL_FROM obsahuje pouze čistou e-mailovou adresu.
EMAIL_FROM_NAME="SeePoint"

# Volitelná výchozí Reply-To adresa (fallback, pokud organizace nemá nastaven vlastní Reply-To).
EMAIL_REPLY_TO=""

# Výchozí skrytá kopie pro systémové notifikace a schválené nabídky (výchozí: info@seepoint.cz).
EMAIL_BCC="info@seepoint.cz"

# Bezpečnostní pojistka pro Preview prostředí (Vercel): "false" blokuje skutečné rozesílání e-mailů klientům z testovacích větví.
EMAIL_SEND_IN_PREVIEW="false"

# [KRITICKÉ PRO PRODUCTION] Šifrovací klíč pro uložení API tokenů firemních domén v databázi (AES-256-GCM).
# Musí být platný 32-bajtový base64 řetězec nebo 32-znakový řetězec.
# Vygenerování: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
EMAIL_CREDENTIALS_ENCRYPTION_KEY=""

# [KRITICKÉ PRO PRODUCTION] Svix webhook secret pro ověření pravosti doručenek z Resendu.
# Začíná předponou "whsec_..." a získáte jej ve Webhooks nastavení v Resend dashboardu.
RESEND_WEBHOOK_SECRET=""

# Volitelný alternativní webhook pro e-maily (pokud se nepoužívá přímé odesílání přes Resend).
# EMAIL_WEBHOOK_URL=""
# EMAIL_WEBHOOK_SECRET=""

# ------------------------------------------------------------------------------
# 4. AI & GOOGLE GEMINI
# ------------------------------------------------------------------------------
# Primární Google Gemini API klíč pro AI Inbox, CRM obohacování dat, OCR a párování skladu.
GEMINI_API_KEY=""

# Podporovaný legacy alias z Vercelu (kód automaticky používá jako fallback):
# GOOGLE_GEMINI_API_KEY=""

# Volitelná konfigurace modelů:
# GEMINI_VISION_MODEL="gemini-3.6-flash"
# GEMINI_VISION_FALLBACK_MODEL="gemini-flash-latest"
# GEMINI_CRM_MODEL="gemini-3.6-flash"

# ------------------------------------------------------------------------------
# 5. GOOGLE MAPS
# ------------------------------------------------------------------------------
# Serverový Google Maps API klíč (geocoding, reverse geocode, Routes API, Static Maps).
# Kód má fallbacky pro staré Vercel názvy: GOOGLE_MAPS_SERVER_KEY, GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_SERVER_API_KEY=""

# Klientský Google Maps API klíč pro frontendové mapy a Places Autocomplete.
# Kód má fallbacky pro staré Vercel názvy: NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY, NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY, NEXT_PUBLIC_GOOGLE_MAPS_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Volitelný URL signing secret pro autorizaci generování Google Static Maps do PDF.
GOOGLE_MAPS_URL_SIGNING_SECRET=""

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH (TENANT INTEGRACE PRO GMAIL & GOOGLE DRIVE)
# ------------------------------------------------------------------------------
# Google Cloud Console OAuth 2.0 Web Client ID a Secret:
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# [KRITICKÉ PRO PRODUCTION] Tajný řetězec pro podepisování CSRF tokenů OAuth toku (minimálně 32 znaků).
# Vygenerování: node -e "console.log(crypto.randomBytes(24).toString('hex'))"
GOOGLE_OAUTH_STATE_SECRET=""

# [KRITICKÉ PRO PRODUCTION] 32-bajtový šifrovací klíč (base64) pro bezpečné uložení refresh tokenů v databázi.
# Vygenerování: node -e "console.log(crypto.randomBytes(32).toString('base64'))"
INTEGRATION_ENCRYPTION_KEY=""

# Kanonický origin aplikace pro OAuth přesměrování (např. https://seepoint.vercel.app nebo https://seepoint.cz).
# Aplikace k němu automaticky přidává callback cestu: /api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_ORIGIN=""

# ------------------------------------------------------------------------------
# 7. GOOGLE DRIVE (SERVICE ACCOUNT & STORAGE)
# ------------------------------------------------------------------------------
# ID kořenové složky na Google Drive, kam se ukládají fotografie nosičů a dokumenty.
GOOGLE_DRIVE_FOLDER_ID=""

# Volitelné ID podsložky pro ukládání generovaných faktur (fallback je GOOGLE_DRIVE_FOLDER_ID).
# GOOGLE_DRIVE_INVOICE_FOLDER_ID=""

# Google Service Account pro nahrávání souborů na Disk:
# Kód podporuje i legacy názvy z Vercelu: GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL a GOOGLE_DRIVE_SERVICE_ACCOUNT_PRIVATE_KEY.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Pouze pro lokální vývoj – mock režim Disku (nepřipojuje se ke skutečnému Disku):
GOOGLE_DRIVE_MOCK_ENABLED="false"

# ------------------------------------------------------------------------------
# 8. CRON & IMPORT JOBS
# ------------------------------------------------------------------------------
# Autorizační bearer token pro zabezpečení Vercel Cron routes (např. /api/cron/sales-radar).
# CRON_SECRET=""

# Bezpečnostní tajný klíč pro autorizaci hromadných importů nosičů a médií.
# IMPORT_SECRET=""

# ------------------------------------------------------------------------------
# 9. SEED ADMIN (PRISMA DB SEED)
# ------------------------------------------------------------------------------
# Používá se příkazem `npm run db:seed` pro vytvoření prvního administrátora.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="SeePoint Admin"

# ------------------------------------------------------------------------------
# 10. STORAGE ABSTRACTION
# ------------------------------------------------------------------------------
SEEPOINT_STORAGE_PROVIDER="GOOGLE_DRIVE"
SEEPOINT_STORAGE_DATABASE_FALLBACK="true"
