# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/seepoint?schema=public"
APP_URL="http://localhost:3000"

# Required by `prisma db seed` to create/update the first admin.
# Never use a fixed default password in production.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="SeePoint Admin"

# Required in production for invitations and password resets. In development URLs are logged to the server console.
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_SECRET=""

# Public browser key for Google Maps JavaScript API.
# If empty, the MVP uses a built-in fallback map for local UI review.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional future storage token for Vercel Blob / object storage uploads.
BLOB_READ_WRITE_TOKEN=""

# Google Drive API configuration
# Enabled Google Drive mock mode (only for non-production environments)
GOOGLE_DRIVE_MOCK_ENABLED="false"
GOOGLE_DRIVE_CLIENT_ID=""
GOOGLE_DRIVE_CLIENT_SECRET=""
GOOGLE_DRIVE_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""
