generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  TECHNICIAN
  WORKER
  ACCOUNTANT
  VIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum UserTokenType {
  ACTIVATION
  PASSWORD_RESET
}

enum AuditAction {
  ACCOUNT_CREATED
  ROLE_CHANGED
  ACCOUNT_ACTIVATED
  ACCOUNT_SUSPENDED
  ACCOUNT_RESTORED
  PASSWORD_CHANGED
  INVITATION_RESENT
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
  FREELANCER
  PART_TIME
  OTHER
}

enum CarrierType {
  BILLBOARD
  BIGBOARD
  CITYLIGHT
  BANNER
  FACADE
  LED_SCREEN
  PROMO_BENCH
  PROMO_HORIZON
  CITY_POSTER
  NAVIGATION
  PROMO_TOWER
  PROMO_MINITOWER
  OTHER
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum GpsStatus {
  MISSING
  UNVERIFIED
  VERIFIED
}

enum MountingType {
  LIGHT_POLE
  POLE
  COLUMN
  TRACTION
  OTHER
  UNKNOWN
}

enum MediaType {
  NAVIGATION_SIGN
  BILLBOARD
  BIGBOARD
  CITYLIGHT
  BANNER
  FACADE
  LED_SCREEN
  PROMO_BENCH
  PROMO_HORIZON
  CITY_POSTER
  PROMO_TOWER
  PROMO_MINITOWER
  OTHER
}

enum SurfaceStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  NEGOTIATION
  OUT_OF_SERVICE
}

enum OccupancyStatus {
  AVAILABLE
  NEGOTIATION
  RESERVED
  OCCUPIED
  FINISHED
  CANCELLED
  OUT_OF_SERVICE
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PhotoType {
  LOCATION
  CARRIER
  CAMPAIGN
  INSTALLATION
  CHECK
  ARCHIVE
  EMPLOYEE_PROFILE
}

enum ImportStatus {
  DRAFT
  VALIDATED
  IMPORTED
  FAILED
}

enum WorkOrderStatus {
  NEW
  PLANNED
  HANDED_OVER
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkType {
  INSTALLATION
  REINSTALLATION
  DEINSTALLATION
  REPAIR
  CHECK
  TRANSPORT
  OTHER
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SettlementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
  REJECTED
}

enum RateType {
  HOURLY
  TASK
  FIXED
}

enum BillingSubjectType {
  INDIVIDUAL
  SOLE_TRADER
  COMPANY
}

enum VehicleType {
  CAR
  VAN
  TRAILER
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_USE
  SERVICE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  RESERVED
  ACTIVE
  FINISHED
  CANCELLED
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  role           Role       @default(VIEWER)
  passwordHash   String?
  status         UserStatus @default(INVITED)
  lastLoginAt    DateTime?
  sessionVersion Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  importBatches   ImportBatch[]
  workAssignments WorkAssignment[]
  employee        Employee?
  sessions        UserSession[]
  tokens          UserToken[]
  auditActions    UserAuditLog[]   @relation("AuditActor")
  auditTargets    UserAuditLog[]   @relation("AuditTarget")
}

model UserSession {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  sessionVersion Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      UserTokenType
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model UserAuditLog {
  id           String      @id @default(cuid())
  action       AuditAction
  actorUserId  String?
  targetUserId String
  metadata     Json?
  createdAt    DateTime    @default(now())
  actor        User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetUserId, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  keyHash     String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
}

model Employee {
  id             String         @id @default(cuid())
  userId         String?        @unique
  firstName      String
  lastName       String
  email          String?        @unique
  phone          String?
  position       String?
  positions      String[]       @default([])
  role           Role           @default(WORKER)
  employmentType EmploymentType @default(EMPLOYEE)
  ico            String?
  dateOfBirth    DateTime?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean        @default(true)
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user                User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTasks       WorkTask[]              @relation("AssignedWorkTasks")
  createdTasks        WorkTask[]              @relation("CreatedWorkTasks")
  settlements         Settlement[]
  vehicleReservations VehicleReservation[]
  billingProfile      EmployeeBillingProfile?
  rates               EmployeeRate[]
  photos              Photo[]
  workEntries         WorkEntry[]

  @@index([role])
  @@index([isActive])
  @@index([lastName, firstName])
}

model EmployeeBillingProfile {
  id               String             @id @default(cuid())
  employeeId       String             @unique
  subjectType      BillingSubjectType @default(INDIVIDUAL)
  billingName      String
  companyId        String?
  vatId            String?
  vatPayer         Boolean            @default(false)
  street           String?
  city             String?
  postalCode       String?
  country          String             @default("CZ")
  accountNumber    String?
  bankCode         String?
  iban             String?
  swift            String?
  billingEmail     String?
  billingPhone     String?
  paymentTermsDays Int?
  note             String?
  updatedByUserId  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  employee         Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model EmployeeRate {
  id              String    @id @default(cuid())
  employeeId      String
  type            RateType
  name            String
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("CZK")
  unit            String?
  workType        WorkType?
  validFrom       DateTime
  validTo         DateTime?
  note            String?
  isActive        Boolean   @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type, workType, validFrom])
  @@index([employeeId, isActive, validFrom, validTo])
}

model Client {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  companyId      String?
  contactPerson  String?
  email          String?
  phone          String?
  externalCode   String?  @unique
  note           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  currentSurfaces AdvertisingSurface[] @relation("CurrentSurfaceClient")
  occupancies     Occupancy[]
  offers          Offer[]
  workOrders      WorkOrder[]
  workEntries     WorkEntry[]
}

model AdvertisingCarrier {
  id                   String        @id @default(cuid())
  name                 String
  code                 String        @unique
  type                 CarrierType
  latitude             Float?
  longitude            Float?
  gpsStatus            GpsStatus     @default(UNVERIFIED)
  street               String?
  address              String?
  locality             String?
  city                 String
  region               String?
  cadastralArea        String?
  structureCode        String?
  mountingType         MountingType  @default(UNKNOWN)
  status               CarrierStatus @default(ACTIVE)
  description          String?
  placementDescription String?
  note                 String?
  archivedAt           DateTime?
  archivedBy           String?
  archiveReason        String?
  sourceSystem         String?
  sourceSheet          String?
  sourceRow            Int?
  sourceKey            String?       @unique
  importBatchId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  importBatch ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  surfaces    AdvertisingSurface[]
  photos      Photo[]
  workItems   WorkOrderItem[]
  workTasks   WorkTask[]

  @@index([importBatchId])
  @@index([archivedAt])
  @@index([city, structureCode])
  @@index([latitude, longitude])
}

model WorkTask {
  id                   String           @id @default(cuid())
  title                String
  description          String?
  assignedToEmployeeId String?
  createdByEmployeeId  String?
  carrierId            String?
  vehicleId            String?
  workOrderId          String?
  dueDate              DateTime?
  scheduledDate        DateTime?
  priority             WorkTaskPriority @default(NORMAL)
  status               WorkTaskStatus   @default(TODO)
  location             String?
  note                 String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  assignedTo  Employee?           @relation("AssignedWorkTasks", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  createdBy   Employee?           @relation("CreatedWorkTasks", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  carrier     AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workOrder   WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items       SettlementItem[]
  workEntries WorkEntry[]

  @@index([assignedToEmployeeId])
  @@index([createdByEmployeeId])
  @@index([carrierId])
  @@index([vehicleId])
  @@index([workOrderId])
  @@index([status, scheduledDate])
  @@index([priority, dueDate])
}

model Settlement {
  id          String           @id @default(cuid())
  employeeId  String
  periodFrom  DateTime
  periodTo    DateTime
  status      SettlementStatus @default(DRAFT)
  totalAmount Decimal?         @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items    SettlementItem[]

  @@index([employeeId])
  @@index([status, periodFrom, periodTo])
}

model SettlementItem {
  id           String   @id @default(cuid())
  settlementId String
  taskId       String?
  date         DateTime
  description  String
  quantity     Decimal? @db.Decimal(10, 2)
  unit         String?
  unitPrice    Decimal? @db.Decimal(12, 2)
  amount       Decimal  @db.Decimal(12, 2)
  note         String?

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  task       WorkTask?  @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([settlementId])
  @@index([taskId])
  @@index([date])
}

model Vehicle {
  id                       String        @id @default(cuid())
  name                     String
  type                     VehicleType   @default(CAR)
  registrationNumber       String?
  vin                      String?
  status                   VehicleStatus @default(AVAILABLE)
  technicalInspectionUntil DateTime?
  insuranceUntil           DateTime?
  note                     String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  reservations   VehicleReservation[]
  serviceRecords VehicleServiceRecord[]
  workTasks      WorkTask[]

  @@index([type, status])
  @@index([registrationNumber])
}

model VehicleReservation {
  id         String            @id @default(cuid())
  vehicleId  String
  employeeId String
  dateFrom   DateTime
  dateTo     DateTime
  purpose    String
  status     ReservationStatus @default(RESERVED)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([employeeId])
  @@index([status, dateFrom, dateTo])
}

model VehicleServiceRecord {
  id              String    @id @default(cuid())
  vehicleId       String
  date            DateTime
  title           String
  description     String?
  cost            Decimal?  @db.Decimal(12, 2)
  mileage         Int?
  nextServiceDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([date])
  @@index([nextServiceDate])
}

model AdvertisingSurface {
  id                   String        @id @default(cuid())
  carrierId            String
  currentClientId      String?
  importBatchId        String?
  name                 String
  mediaType            MediaType     @default(OTHER)
  sourcePosition       String?
  directionDescription String?
  rawMediaType         String?
  sourceKey            String?       @unique
  size                 String?
  orientation          String?
  status               SurfaceStatus @default(AVAILABLE)
  price                Decimal?      @db.Decimal(12, 2)
  note                 String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  carrier       AdvertisingCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  currentClient Client?            @relation("CurrentSurfaceClient", fields: [currentClientId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  occupancies   Occupancy[]
  offerItems    OfferItem[]
  photos        Photo[]
  workItems     WorkOrderItem[]

  @@index([carrierId])
  @@index([currentClientId])
  @@index([importBatchId])
  @@index([mediaType, status])
}

model Occupancy {
  id            String          @id @default(cuid())
  surfaceId     String
  clientId      String?
  clientName    String
  campaignName  String
  dateFrom      DateTime
  dateTo        DateTime
  status        OccupancyStatus @default(RESERVED)
  price         Decimal?        @db.Decimal(12, 2)
  note          String?
  createdBy     String?
  updatedBy     String?
  reservedUntil DateTime?
  offerId       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  surface AdvertisingSurface @relation(fields: [surfaceId], references: [id], onDelete: Cascade)
  client  Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  offer   Offer?             @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@index([surfaceId])
  @@index([clientId])
  @@index([offerId])
  @@index([status, dateFrom, dateTo])
}

model Offer {
  id         String      @id @default(cuid())
  clientId   String
  title      String
  status     OfferStatus @default(DRAFT)
  validUntil DateTime?
  note       String?
  totalPrice Decimal?    @db.Decimal(12, 2)
  createdBy  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  items       OfferItem[]
  occupancies Occupancy[]

  @@index([clientId])
  @@index([status, validUntil])
}

model OfferItem {
  id        String   @id @default(cuid())
  offerId   String
  surfaceId String
  dateFrom  DateTime
  dateTo    DateTime
  price     Decimal? @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())

  offer   Offer              @relation(fields: [offerId], references: [id], onDelete: Cascade)
  surface AdvertisingSurface @relation(fields: [surfaceId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([surfaceId])
  @@index([dateFrom, dateTo])
}

model Photo {
  id              String    @id @default(cuid())
  carrierId       String?
  surfaceId       String?
  employeeId      String?
  url             String
  driveFileId     String?
  fileName        String?
  mimeType        String?
  size            Int?
  type            PhotoType @default(CARRIER)
  note            String?
  sortOrder       Int       @default(0)
  isPrimary       Boolean   @default(false)
  isClientVisible Boolean   @default(false)
  createdAt       DateTime  @default(now())

  carrier  AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  surface  AdvertisingSurface? @relation(fields: [surfaceId], references: [id], onDelete: Cascade)
  employee Employee?           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([carrierId, driveFileId])
  @@index([carrierId])
  @@index([carrierId, sortOrder])
  @@index([surfaceId])
  @@index([employeeId])
}

model ImportBatch {
  id           String       @id @default(cuid())
  fileName     String
  sourceType   String
  status       ImportStatus @default(DRAFT)
  totalRows    Int          @default(0)
  validRows    Int          @default(0)
  importedRows Int          @default(0)
  skippedRows  Int          @default(0)
  errorRows    Int          @default(0)
  mapping      Json?
  createdById  String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  carriers  AdvertisingCarrier[]
  surfaces  AdvertisingSurface[]
  errors    ImportRowError[]

  @@index([createdById])
  @@index([status, createdAt])
}

model ImportRowError {
  id        String   @id @default(cuid())
  batchId   String
  rowNumber Int
  sheetName String?
  field     String?
  code      String
  message   String
  rawData   Json
  createdAt DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
}

model WorkOrder {
  id               String          @id @default(cuid())
  title            String
  description      String
  status           WorkOrderStatus @default(NEW)
  priority         WorkPriority    @default(NORMAL)
  workType         WorkType        @default(OTHER)
  scheduledAt      DateTime
  deadlineAt       DateTime?
  campaignDateFrom DateTime?
  campaignDateTo   DateTime?
  clientId         String?
  clientName       String
  requestedBy      String?
  contactName      String?
  contactPhone     String?
  locationNote     String?
  mediaLabel       String?
  quantity         Int?
  price            Decimal?        @db.Decimal(12, 2)
  referenceUrl     String?
  ftdUrl           String?
  ftdSent          Boolean         @default(false)
  invoiced         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignments WorkAssignment[]
  items       WorkOrderItem[]
  workTasks   WorkTask[]
  workEntries WorkEntry[]
  rates       WorkOrderRate[]

  @@index([scheduledAt, status])
  @@index([priority, scheduledAt])
  @@index([clientId])
}

model WorkAssignment {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String?
  workerName  String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([userId])
}

model WorkOrderItem {
  id          String   @id @default(cuid())
  workOrderId String
  carrierId   String?
  surfaceId   String?
  description String?
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  workOrder WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  carrier   AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  surface   AdvertisingSurface? @relation(fields: [surfaceId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([carrierId])
  @@index([surfaceId])
}

enum WorkEntryStatus {
  DRAFT
  CONFIRMED
}

enum WorkEntryCreationSource {
  AUTOMATIC
  MANUAL
}

enum RateSource {
  EMPLOYEE_RATE
  WORK_ORDER_RATE
  COMPANY_RATE
  MANUAL
}

model WorkOrderRate {
  id              String    @id @default(cuid())
  workOrderId     String
  type            RateType
  name            String
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("CZK")
  unit            String?
  workType        WorkType?
  validFrom       DateTime
  validTo         DateTime?
  note            String?
  isActive        Boolean   @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([type, workType, validFrom])
  @@index([isActive, validFrom, validTo])
}

model CompanyRate {
  id              String    @id @default(cuid())
  type            RateType
  name            String
  amount          Decimal   @db.Decimal(12, 2)
  currency        String    @default("CZK")
  unit            String?
  workType        WorkType?
  validFrom       DateTime
  validTo         DateTime?
  note            String?
  isActive        Boolean   @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([type, workType, validFrom])
  @@index([isActive, validFrom, validTo])
}

model WorkEntry {
  id                 String                  @id @default(cuid())
  employeeId         String
  workDate           DateTime
  workTaskId         String
  workOrderId        String?
  clientId           String?
  clientName         String?
  workType           WorkType
  remunerationMethod RateType
  quantity           Decimal                 @db.Decimal(10, 4)
  unit               String
  appliedUnitRate    Decimal?                @db.Decimal(12, 2)
  calculatedAmount   Decimal                 @db.Decimal(12, 2)
  rateSource         RateSource?
  note               String?
  status             WorkEntryStatus         @default(DRAFT)
  creationSource     WorkEntryCreationSource @default(MANUAL)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  employee  Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workTask  WorkTask   @relation(fields: [workTaskId], references: [id], onDelete: Restrict)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([workTaskId])
  @@index([workOrderId])
  @@index([status])
  @@index([workDate])
}
