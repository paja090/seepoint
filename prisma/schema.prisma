generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  TECHNICIAN
  WORKER
  ACCOUNTANT
  VIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum UserTokenType {
  ACTIVATION
  PASSWORD_RESET
}

enum AuditAction {
  ACCOUNT_CREATED
  ROLE_CHANGED
  ACCOUNT_ACTIVATED
  ACCOUNT_SUSPENDED
  ACCOUNT_RESTORED
  PASSWORD_CHANGED
  INVITATION_RESENT
}

enum EmploymentType {
  EMPLOYEE
  DPP
  DPC
  CONTRACTOR
  FREELANCER
  PART_TIME
  OTHER
}

enum CarrierType {
  BILLBOARD
  BIGBOARD
  CITYLIGHT
  BANNER
  FACADE
  LED_SCREEN
  PROMO_BENCH
  PROMO_HORIZON
  CITY_POSTER
  NAVIGATION
  PROMO_TOWER
  PROMO_MINITOWER
  OTHER
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum GpsStatus {
  MISSING
  UNVERIFIED
  VERIFIED
}

enum MountingType {
  LIGHT_POLE
  POLE
  COLUMN
  TRACTION
  OTHER
  UNKNOWN
}

enum MediaType {
  NAVIGATION_SIGN
  BILLBOARD
  BIGBOARD
  CITYLIGHT
  BANNER
  FACADE
  LED_SCREEN
  PROMO_BENCH
  PROMO_HORIZON
  CITY_POSTER
  PROMO_TOWER
  PROMO_MINITOWER
  OTHER
}

enum SurfaceStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  NEGOTIATION
  OUT_OF_SERVICE
}

enum OccupancyStatus {
  AVAILABLE
  NEGOTIATION
  RESERVED
  OCCUPIED
  FINISHED
  CANCELLED
  OUT_OF_SERVICE
}

enum ClientResolutionStatus {
  RESOLVED
  UNRESOLVED
}

enum ClientPricingSegment {
  COMMERCIAL
  CULTURE_SPORT
  PUBLIC_NONPROFIT
  CUSTOM
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OfferType {
  STANDARD_MEDIA
  NAVIGATION
  CITY_GALLERY
}

enum OpportunityEventType {
  NEW_BRANCH
  NEW_ESTABLISHMENT
  STORE_OPENING
  RESTAURANT_OPENING
  CAR_DEALERSHIP
  RETAIL_PARK
  RETAIL_PARK_TENANT
  EXPANSION
  RELOCATION
  REOPENING
  MARKETING_EVENT
  SEASONAL_CAMPAIGN
  NEW_PRODUCT_SERVICE
  EVENT_EXHIBITION
  MASS_RECRUITMENT
  OTHER
}

enum OpportunityStatus {
  NEW
  REVIEWED
  CONTACT_PLANNED
  CONTACTED
  PROPOSAL_CREATED
  CONVERTED
  DISMISSED
}

enum NavigationPointStatus {
  PLANNED
  APPROVAL_REQUIRED
  APPROVED
  TECHNICAL_CHECK
  READY_FOR_INSTALLATION
  INSTALLED
  REMOVED
  CANCELLED
}

enum NavigationDistanceSource {
  CALCULATED
  MANUAL
}

enum DistanceUnit {
  METERS
  KILOMETERS
}

enum NavigationRouteProvider {
  GOOGLE_ROUTES
  OSRM
  MANUAL
}

enum NavigationTravelMode {
  DRIVING
  BICYCLING
  WALKING
}

enum NavigationRouteStatus {
  OK
  NOT_FOUND
  FAILED
}

enum NavigationArrowDirection {
  LEFT
  RIGHT
  STRAIGHT
  SLANTED_LEFT
  SLANTED_RIGHT
  U_TURN
  TWO_WAY
}

enum CityGalleryProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MediaPackageSelectionMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum OfferEventType {
  CREATED
  UPDATED
  DUPLICATED
  PUBLISHED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  QUESTION
  CONVERTED
  ARCHIVED
}

enum OfferPriceCategory {
  RENTAL
  PRINT
  INSTALLATION
  REMOVAL
  PRODUCTION
  SERVICE
}

enum OfferPriceCalculation {
  PER_SURFACE
  FLAT
}

enum PhotoType {
  LOCATION
  CARRIER
  SURFACE
  CAMPAIGN
  INSTALLATION
  BEFORE_INSTALLATION
  AFTER_INSTALLATION
  CONTROL
  DAMAGE
  AFTER_DEINSTALLATION
  CHECK
  ARCHIVE
  EMPLOYEE_PROFILE
  EXPENSE_RECEIPT
  SURVEY
}

enum CandidateSurveyStatus {
  DRAFT
  COMPLETED
}

enum CandidateSupervisionStatus {
  PENDING_REVIEW
  APPROVED
  NEEDS_RECHECK
  REJECTED
}

enum CandidateVisibilityQuality {
  GOOD
  NEEDS_CHECK
  POOR
}

enum CandidateOwnershipType {
  CITY_MUNICIPALITY
  PRIVATE_OWNER
  SEEPOINT
  OTHER
  UNKNOWN
}

enum CandidatePermitStatus {
  UNKNOWN
  NEEDS_VERIFICATION
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ImportStatus {
  DRAFT
  VALIDATED
  IMPORTED
  FAILED
}

enum WorkOrderStatus {
  NEW
  PLANNED
  HANDED_OVER
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkType {
  INSTALLATION
  REINSTALLATION
  DEINSTALLATION
  REPAIR
  CHECK
  TRANSPORT
  OTHER
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SettlementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  LOCKED
  PAID
  REJECTED
}

enum RateType {
  HOURLY
  TASK
  FIXED
}

enum BillingSubjectType {
  INDIVIDUAL
  SOLE_TRADER
  COMPANY
}

enum VehicleType {
  CAR
  VAN
  TRAILER
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_USE
  SERVICE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  RESERVED
  ACTIVE
  FINISHED
  CANCELLED
}

model User {
  id                 String     @id @default(cuid())
  name               String
  email              String     @unique
  role               Role       @default(VIEWER)
  roles              Role[]     @default([])
  passwordHash       String?
  mustChangePassword Boolean    @default(false)
  status             UserStatus @default(INVITED)
  lastLoginAt        DateTime?
  sessionVersion     Int        @default(1)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  importBatches                  ImportBatch[]
  workAssignments                WorkAssignment[]
  employee                       Employee?
  sessions                       UserSession[]
  tokens                         UserToken[]
  auditActions                   UserAuditLog[]                  @relation("AuditActor")
  auditTargets                   UserAuditLog[]                  @relation("AuditTarget")
  createdOffers                  Offer[]                         @relation("OfferCreatedBy")
  updatedOffers                  Offer[]                         @relation("OfferUpdatedBy")
  offerEvents                    OfferEvent[]
  createdOfferPriceRules         OfferPriceRule[]                @relation("OfferPriceRuleCreatedBy")
  updatedOfferPriceRules         OfferPriceRule[]                @relation("OfferPriceRuleUpdatedBy")
  offerItemPriceOverrides        OfferItem[]                     @relation("OfferItemPriceOverride")
  navigationDocumentationReports NavigationDocumentationReport[]
  navigationReportAuditLogs      NavigationReportAuditLog[]
  assignedClients                Client[]                        @relation("ClientAssignedUser")
  assignedCrmOrders              CrmOrder[]                      @relation("CrmOrderAssignedUser")
  assignedRealizations           CrmRealization[]                @relation("CrmRealizationAssignedUser")
  assignedContracts              ClientContract[]                @relation("ClientContractAssignedUser")
  communicationAuthorLogs        ClientCommunication[]           @relation("CommunicationAuthor")
  assignedCrmTasks               CrmTask[]                       @relation("CrmTaskAssignedUser")
  createdCrmTasks                CrmTask[]                       @relation("CrmTaskCreatedUser")
  createdQuickInternalTasks      QuickInternalTask[]             @relation("CreatedQuickTasks")
  uploadedClientDocuments        ClientDocument[]                @relation("ClientDocumentUploader")
  crmAuditLogs                   CrmAuditLog[]
  performedClientMerges          ClientMergeLog[]
  navigationPriceAuditLogs       NavigationPriceAuditLog[]       @relation("NavigationPriceAuditUser")
  navigationPriceVersions        NavigationPriceVersion[]        @relation("NavigationPriceChangedUser")
  assignedNavigationOrders       NavigationOrder[]               @relation("NavOrderInstaller")
  assignedNavigationPoints       NavigationPoint[]               @relation("NavPointInstaller")
  createdCandidatePoints         NavigationCandidatePoint[]      @relation("CandidateCreatedBy")
  assignedCandidatePoints        NavigationCandidatePoint[]      @relation("CandidateAssignedTo")
  supervisionCandidatePoints     NavigationCandidatePoint[]      @relation("CandidateSupervisionBy")
  assignedOpportunities          SalesOpportunity[]              @relation("OpportunityAssignedUser")
}

model UserSession {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  sessionVersion Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      UserTokenType
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model UserAuditLog {
  id           String      @id @default(cuid())
  action       AuditAction
  actorUserId  String?
  targetUserId String
  metadata     Json?
  createdAt    DateTime    @default(now())
  actor        User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetUserId, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  keyHash     String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
}

model Employee {
  id             String         @id @default(cuid())
  userId         String?        @unique
  firstName      String
  lastName       String
  email          String?        @unique
  phone          String?
  position       String?
  positions      String[]       @default([])
  role           Role           @default(WORKER)
  roles          Role[]         @default([])
  employmentType EmploymentType @default(EMPLOYEE)
  ico            String?
  dateOfBirth    DateTime?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean        @default(true)
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTasks              WorkTask[]              @relation("AssignedWorkTasks")
  createdTasks               WorkTask[]              @relation("CreatedWorkTasks")
  assignedQuickInternalTasks QuickInternalTask[]     @relation("AssignedQuickTasks")
  settlements                Settlement[]
  vehicleReservations  VehicleReservation[]
  fuelExpenses         VehicleFuelExpense[]
  absences             EmployeeAbsence[]
  billingProfile       EmployeeBillingProfile?
  rates                EmployeeRate[]
  photos               Photo[]
  workEntries          WorkEntry[]
  recurringAdjustments RecurringAdjustment[]

  @@index([role])
  @@index([isActive])
  @@index([lastName, firstName])
}

model EmployeeBillingProfile {
  id                  String             @id @default(cuid())
  employeeId          String             @unique
  subjectType         BillingSubjectType @default(INDIVIDUAL)
  billingName         String
  companyId           String?
  vatId               String?
  vatPayer            Boolean            @default(false)
  street              String?
  city                String?
  postalCode          String?
  country             String             @default("CZ")
  accountNumber       String?
  bankCode            String?
  iban                String?
  swift               String?
  billingEmail        String?
  billingPhone        String?
  paymentTermsDays    Int?
  note                String?
  updatedByUserId     String?
  invoiceEnabled      Boolean            @default(false)
  invoiceNumberPrefix String?
  nextInvoiceNumber   Int                @default(1)
  defaultDueDays      Int                @default(14)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  employee            Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model EmployeeRate {
  id              String       @id @default(cuid())
  employeeId      String
  type            RateType
  name            String
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("CZK")
  unit            String?
  workType        WorkType?
  carrierType     CarrierType?
  validFrom       DateTime
  validTo         DateTime?
  note            String?
  isActive        Boolean      @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type, workType, validFrom])
  @@index([employeeId, isActive, validFrom, validTo])
}

model Client {
  id              String               @id @default(cuid())
  name            String
  normalizedName  String               @unique
  companyId       String?
  tradingName     String?
  dic             String?
  billingStreet   String?
  billingCity     String?
  billingZip      String?
  billingCountry  String?              @default("CZ")
  shippingStreet  String?
  shippingCity    String?
  shippingZip     String?
  shippingCountry String?              @default("CZ")
  website         String?
  contactPerson   String?
  email           String?
  phone           String?
  externalCode    String?              @unique
  status          ClientStatus         @default(ACTIVE)
  clientType      ClientType           @default(DIRECT_CLIENT)
  pricingSegment  ClientPricingSegment @default(COMMERCIAL)
  source          ClientSource         @default(WEBSITE)
  assignedUserId  String?
  rating          String?
  lastActivityAt  DateTime             @default(now())
  note            String?
  logoDriveFileId String?              @unique
  logoFileName    String?
  logoMimeType    String?
  logoUpdatedAt   DateTime?
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  assignedUser                   User?                           @relation("ClientAssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  currentSurfaces                AdvertisingSurface[]            @relation("CurrentSurfaceClient")
  occupancies                    Occupancy[]
  offers                         Offer[]
  workOrders                     WorkOrder[]
  workEntries                    WorkEntry[]
  navigationDocumentationReports NavigationDocumentationReport[]
  contacts                       ClientContact[]
  branches                       ClientBranch[]
  crmOrders                      CrmOrder[]
  contracts                      ClientContract[]
  invoices                       ClientInvoice[]
  communications                 ClientCommunication[]
  crmTasks                       CrmTask[]
  documents                      ClientDocument[]
  mergedTargetLogs               ClientMergeLog[]
  navigationContracts            NavigationContract[]
  navigationContactPersons       NavigationContactPerson[]
  salesOpportunities             SalesOpportunity[]
}

model AdvertisingCarrier {
  id                   String        @id @default(cuid())
  name                 String
  code                 String        @unique
  type                 CarrierType
  latitude             Float?
  longitude            Float?
  gpsStatus            GpsStatus     @default(UNVERIFIED)
  street               String?
  address              String?
  locality             String?
  city                 String
  region               String?
  cadastralArea        String?
  structureCode        String?
  mountingType         MountingType  @default(UNKNOWN)
  status               CarrierStatus @default(ACTIVE)
  description          String?
  placementDescription String?
  note                 String?
  archivedAt           DateTime?
  archivedBy           String?
  archiveReason        String?
  sourceSystem         String?
  sourceSheet          String?
  sourceRow            Int?
  sourceKey            String?       @unique
  importBatchId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  importBatch                  ImportBatch?                  @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  surfaces                     AdvertisingSurface[]
  photos                       Photo[]
  workItems                    WorkOrderItem[]
  workTasks                    WorkTask[]
  crmRealizations              CrmRealization[]
  navigationPoints             NavigationPoint[]
  navigationDocumentationItems NavigationDocumentationItem[]
  historyLogs                  CarrierHistoryLog[]
  candidatePoints              NavigationCandidatePoint[]

  @@index([importBatchId])
  @@index([archivedAt])
  @@index([city, structureCode])
  @@index([latitude, longitude])
}

model WorkTask {
  id                   String           @id @default(cuid())
  title                String
  description          String?
  assignedToEmployeeId String?
  createdByEmployeeId  String?
  carrierId            String?
  vehicleId            String?
  workOrderId          String?
  dueDate              DateTime?
  scheduledDate        DateTime?
  priority             WorkTaskPriority @default(NORMAL)
  status               WorkTaskStatus   @default(TODO)
  location             String?
  note                 String?
  remunerationMethod   RateType         @default(HOURLY)
  plannedQuantity      Decimal?         @db.Decimal(10, 2)
  plannedTimeHours     Decimal?         @db.Decimal(10, 2)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  assignedTo  Employee?           @relation("AssignedWorkTasks", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  createdBy   Employee?           @relation("CreatedWorkTasks", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  carrier     AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workOrder   WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items       SettlementItem[]
  workEntries WorkEntry[]
  photos      Photo[]

  @@index([assignedToEmployeeId])
  @@index([createdByEmployeeId])
  @@index([carrierId])
  @@index([vehicleId])
  @@index([workOrderId])
  @@index([status, scheduledDate])
  @@index([priority, dueDate])
}

model Settlement {
  id                  String           @id @default(cuid())
  employeeId          String
  periodFrom          DateTime
  periodTo            DateTime
  periodYear          Int
  periodMonth         Int
  status              SettlementStatus @default(DRAFT)
  totalAmount         Decimal?         @db.Decimal(12, 2)
  totalWorkAmount     Decimal          @default(0) @db.Decimal(12, 2)
  totalReimbursements Decimal          @default(0) @db.Decimal(12, 2)
  totalDeductions     Decimal          @default(0) @db.Decimal(12, 2)
  totalAdvances       Decimal          @default(0) @db.Decimal(12, 2)
  finalPayableAmount  Decimal          @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal?         @db.Decimal(12, 2)
  paymentDate         DateTime?
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items                 SettlementItem[]
  adjustments           SettlementAdjustment[]
  auditLogs             SettlementAuditLog[]
  invoice               Invoice?
  correctionAdjustments SettlementAdjustment[] @relation("CorrectionOriginalSettlement")

  @@unique([employeeId, periodYear, periodMonth])
  @@index([employeeId])
  @@index([status, periodFrom, periodTo])
}

model SettlementItem {
  id           String       @id @default(cuid())
  settlementId String
  taskId       String?
  workEntryId  String?      @unique
  date         DateTime
  description  String
  quantity     Decimal?     @db.Decimal(10, 2)
  unit         String?
  unitPrice    Decimal?     @db.Decimal(12, 2)
  amount       Decimal      @db.Decimal(12, 2)
  appliedRate  Decimal      @default(0) @db.Decimal(12, 2)
  rateType     RateType?
  rateSource   RateSource?
  rateId       String?
  carrierType  CarrierType?
  workType     WorkType?
  note         String?

  settlement            Settlement             @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  task                  WorkTask?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workEntry             WorkEntry?             @relation(fields: [workEntryId], references: [id], onDelete: Restrict)
  settlementAdjustments SettlementAdjustment[]

  @@index([settlementId])
  @@index([taskId])
  @@index([date])
}

model Vehicle {
  id                       String        @id @default(cuid())
  name                     String
  type                     VehicleType   @default(CAR)
  registrationNumber       String?
  vin                      String?
  status                   VehicleStatus @default(AVAILABLE)
  technicalInspectionUntil DateTime?
  insuranceUntil           DateTime?
  highwayPassUntil         DateTime?
  responsiblePerson        String?
  tiresInfo                String?
  owner                    String?
  vtpUrl                   String?
  repairNotes              String?
  photoUrl                 String?
  note                     String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  reservations   VehicleReservation[]
  serviceRecords VehicleServiceRecord[]
  fuelExpenses   VehicleFuelExpense[]
  workTasks      WorkTask[]

  @@index([type, status])
  @@index([registrationNumber])
}

model VehicleReservation {
  id         String            @id @default(cuid())
  vehicleId  String
  employeeId String
  dateFrom   DateTime
  dateTo     DateTime
  purpose    String
  status     ReservationStatus @default(RESERVED)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([employeeId])
  @@index([status, dateFrom, dateTo])
}

model VehicleServiceRecord {
  id              String    @id @default(cuid())
  vehicleId       String
  date            DateTime
  title           String
  description     String?
  cost            Decimal?  @db.Decimal(12, 2)
  mileage         Int?
  nextServiceDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([date])
  @@index([nextServiceDate])
}

model VehicleFuelExpense {
  id         String   @id @default(cuid())
  vehicleId  String
  employeeId String?
  userId     String?
  amount     Decimal  @db.Decimal(12, 2)
  liters     Decimal? @db.Decimal(10, 2)
  odometer   Int?
  fuelType   String   @default("DIESEL")
  receiptUrl String?
  note       String?
  createdAt  DateTime @default(now())

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([vehicleId])
  @@index([employeeId])
  @@index([createdAt])
}

enum AbsenceType {
  VACATION
  SICK_LEAVE
  PERSONAL_LEAVE
  HOME_OFFICE
}

enum AbsenceStatus {
  PENDING
  APPROVED
  REJECTED
}

model EmployeeAbsence {
  id         String        @id @default(cuid())
  employeeId String
  type       AbsenceType   @default(VACATION)
  dateFrom   DateTime
  dateTo     DateTime
  note       String?
  status     AbsenceStatus @default(APPROVED)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([dateFrom, dateTo])
  @@index([status])
}

model ChatMessage {
  id                 String    @id @default(cuid())
  channel            String    @default("general")
  userId             String
  userName           String
  userRole           String
  content            String
  imageUrl           String?
  fuelExpenseId      String?
  assignedToUserId   String?
  assignedToUserName String?
  isResolved         Boolean   @default(false)
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())

  reads ChatRead[]

  @@index([channel, createdAt])
  @@index([assignedToUserId])
}

model ChatRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model AdvertisingSurface {
  id                   String        @id @default(cuid())
  carrierId            String
  currentClientId      String?
  importBatchId        String?
  name                 String
  mediaType            MediaType     @default(OTHER)
  sourcePosition       String?
  directionDescription String?
  destinationName      String?
