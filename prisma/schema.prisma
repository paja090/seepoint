generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { ADMIN SALES TECHNICIAN VIEWER }
enum CarrierType { BILLBOARD BIGBOARD CITYLIGHT BANNER FACADE LED_SCREEN OTHER }
enum CarrierStatus { ACTIVE INACTIVE MAINTENANCE }
enum SurfaceStatus { AVAILABLE RESERVED OCCUPIED NEGOTIATION OUT_OF_SERVICE }
enum OccupancyStatus { RESERVED ACTIVE FINISHED CANCELLED }
enum PhotoType { LOCATION CARRIER CAMPAIGN INSTALLATION CHECK ARCHIVE }

model User { id String @id @default(cuid()) name String email String @unique role Role @default(VIEWER) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model AdvertisingCarrier {
  id String @id @default(cuid()) name String code String @unique type CarrierType latitude Float longitude Float address String? city String region String? status CarrierStatus @default(ACTIVE) note String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt
  surfaces AdvertisingSurface[] photos Photo[]
}
model AdvertisingSurface {
  id String @id @default(cuid()) carrierId String name String size String? orientation String? status SurfaceStatus @default(AVAILABLE) price Decimal? @db.Decimal(12,2) note String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt
  carrier AdvertisingCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade) occupancies Occupancy[] photos Photo[]
}
model Occupancy {
  id String @id @default(cuid()) surfaceId String clientName String campaignName String dateFrom DateTime dateTo DateTime status OccupancyStatus @default(RESERVED) price Decimal? @db.Decimal(12,2) note String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt
  surface AdvertisingSurface @relation(fields: [surfaceId], references: [id], onDelete: Cascade)
}
model Photo {
  id String @id @default(cuid()) carrierId String? surfaceId String? url String type PhotoType @default(CARRIER) note String? createdAt DateTime @default(now())
  carrier AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: Cascade) surface AdvertisingSurface? @relation(fields: [surfaceId], references: [id], onDelete: Cascade)
}
