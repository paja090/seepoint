generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  SALES
  TECHNICIAN
  WORKER
  ACCOUNTANT
  VIEWER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum UserTokenType {
  ACTIVATION
  PASSWORD_RESET
}

enum AuditAction {
  ACCOUNT_CREATED
  ROLE_CHANGED
  ACCOUNT_ACTIVATED
  ACCOUNT_SUSPENDED
  ACCOUNT_RESTORED
  PASSWORD_CHANGED
  INVITATION_RESENT
}

enum EmploymentType {
  EMPLOYEE
  DPP
  DPC
  CONTRACTOR
  FREELANCER
  PART_TIME
  OTHER
}

enum CarrierType {
  BILLBOARD
  BIGBOARD
  CITYLIGHT
  BANNER
  FACADE
  LED_SCREEN
  PROMO_BENCH
  PROMO_HORIZON
  CITY_POSTER
  NAVIGATION
  PROMO_TOWER
  PROMO_MINITOWER
  OTHER
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum GpsStatus {
  MISSING
  UNVERIFIED
  VERIFIED
}

enum MountingType {
  LIGHT_POLE
  POLE
  COLUMN
  TRACTION
  OTHER
  UNKNOWN
}

enum MediaType {
  NAVIGATION_SIGN
  BILLBOARD
  BIGBOARD
  CITYLIGHT
  BANNER
  FACADE
  LED_SCREEN
  PROMO_BENCH
  PROMO_HORIZON
  CITY_POSTER
  PROMO_TOWER
  PROMO_MINITOWER
  OTHER
}

enum SurfaceStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  NEGOTIATION
  OUT_OF_SERVICE
}

enum OccupancyStatus {
  AVAILABLE
  NEGOTIATION
  RESERVED
  OCCUPIED
  FINISHED
  CANCELLED
  OUT_OF_SERVICE
}

enum ClientResolutionStatus {
  RESOLVED
  UNRESOLVED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum OfferType {
  STANDARD_MEDIA
  NAVIGATION
  CITY_GALLERY
}

enum NavigationPointStatus {
  PLANNED
  APPROVAL_REQUIRED
  APPROVED
  TECHNICAL_CHECK
  READY_FOR_INSTALLATION
  INSTALLED
  REMOVED
  CANCELLED
}

enum CityGalleryProjectStatus {
  DRAFT
  PLANNED
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MediaPackageSelectionMode {
  MANUAL
  AUTOMATIC
  HYBRID
}

enum OfferEventType {
  CREATED
  UPDATED
  DUPLICATED
  PUBLISHED
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  QUESTION
  CONVERTED
  ARCHIVED
}

enum OfferPriceCategory {
  RENTAL
  PRINT
  INSTALLATION
  REMOVAL
  PRODUCTION
  SERVICE
}

enum OfferPriceCalculation {
  PER_SURFACE
  FLAT
}

enum PhotoType {
  LOCATION
  CARRIER
  CAMPAIGN
  INSTALLATION
  CHECK
  ARCHIVE
  EMPLOYEE_PROFILE
  EXPENSE_RECEIPT
}

enum ImportStatus {
  DRAFT
  VALIDATED
  IMPORTED
  FAILED
}

enum WorkOrderStatus {
  NEW
  PLANNED
  HANDED_OVER
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum WorkType {
  INSTALLATION
  REINSTALLATION
  DEINSTALLATION
  REPAIR
  CHECK
  TRANSPORT
  OTHER
}

enum WorkTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SettlementStatus {
  DRAFT
  SUBMITTED
  APPROVED
  LOCKED
  PAID
  REJECTED
}

enum RateType {
  HOURLY
  TASK
  FIXED
}

enum BillingSubjectType {
  INDIVIDUAL
  SOLE_TRADER
  COMPANY
}

enum VehicleType {
  CAR
  VAN
  TRAILER
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  IN_USE
  SERVICE
  OUT_OF_SERVICE
}

enum ReservationStatus {
  RESERVED
  ACTIVE
  FINISHED
  CANCELLED
}

model User {
  id             String     @id @default(cuid())
  name           String
  email          String     @unique
  role           Role       @default(VIEWER)
  passwordHash   String?
  status         UserStatus @default(INVITED)
  lastLoginAt    DateTime?
  sessionVersion Int        @default(1)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  importBatches          ImportBatch[]
  workAssignments        WorkAssignment[]
  employee               Employee?
  sessions               UserSession[]
  tokens                 UserToken[]
  auditActions           UserAuditLog[]   @relation("AuditActor")
  auditTargets           UserAuditLog[]   @relation("AuditTarget")
  createdOffers          Offer[]          @relation("OfferCreatedBy")
  updatedOffers          Offer[]          @relation("OfferUpdatedBy")
  offerEvents            OfferEvent[]
  createdOfferPriceRules OfferPriceRule[] @relation("OfferPriceRuleCreatedBy")
  updatedOfferPriceRules OfferPriceRule[] @relation("OfferPriceRuleUpdatedBy")
}

model UserSession {
  id             String   @id @default(cuid())
  tokenHash      String   @unique
  userId         String
  sessionVersion Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  type      UserTokenType
  expiresAt DateTime
  usedAt    DateTime?
  userId    String
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model UserAuditLog {
  id           String      @id @default(cuid())
  action       AuditAction
  actorUserId  String?
  targetUserId String
  metadata     Json?
  createdAt    DateTime    @default(now())
  actor        User?       @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  target       User        @relation("AuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetUserId, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  scope       String
  keyHash     String
  windowStart DateTime
  expiresAt   DateTime
  count       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([scope, keyHash, windowStart])
  @@index([expiresAt])
}

model Employee {
  id             String         @id @default(cuid())
  userId         String?        @unique
  firstName      String
  lastName       String
  email          String?        @unique
  phone          String?
  position       String?
  positions      String[]       @default([])
  role           Role           @default(WORKER)
  employmentType EmploymentType @default(EMPLOYEE)
  ico            String?
  dateOfBirth    DateTime?
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean        @default(true)
  note           String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user                 User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedTasks        WorkTask[]              @relation("AssignedWorkTasks")
  createdTasks         WorkTask[]              @relation("CreatedWorkTasks")
  settlements          Settlement[]
  vehicleReservations  VehicleReservation[]
  billingProfile       EmployeeBillingProfile?
  rates                EmployeeRate[]
  photos               Photo[]
  workEntries          WorkEntry[]
  recurringAdjustments RecurringAdjustment[]

  @@index([role])
  @@index([isActive])
  @@index([lastName, firstName])
}

model EmployeeBillingProfile {
  id                  String             @id @default(cuid())
  employeeId          String             @unique
  subjectType         BillingSubjectType @default(INDIVIDUAL)
  billingName         String
  companyId           String?
  vatId               String?
  vatPayer            Boolean            @default(false)
  street              String?
  city                String?
  postalCode          String?
  country             String             @default("CZ")
  accountNumber       String?
  bankCode            String?
  iban                String?
  swift               String?
  billingEmail        String?
  billingPhone        String?
  paymentTermsDays    Int?
  note                String?
  updatedByUserId     String?
  invoiceEnabled      Boolean            @default(false)
  invoiceNumberPrefix String?
  nextInvoiceNumber   Int                @default(1)
  defaultDueDays      Int                @default(14)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  employee            Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model EmployeeRate {
  id              String       @id @default(cuid())
  employeeId      String
  type            RateType
  name            String
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("CZK")
  unit            String?
  workType        WorkType?
  carrierType     CarrierType?
  validFrom       DateTime
  validTo         DateTime?
  note            String?
  isActive        Boolean      @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, type, workType, validFrom])
  @@index([employeeId, isActive, validFrom, validTo])
}

model Client {
  id              String    @id @default(cuid())
  name            String
  normalizedName  String    @unique
  companyId       String?
  contactPerson   String?
  email           String?
  phone           String?
  externalCode    String?   @unique
  note            String?
  logoDriveFileId String?   @unique
  logoFileName    String?
  logoMimeType    String?
  logoUpdatedAt   DateTime?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  currentSurfaces AdvertisingSurface[] @relation("CurrentSurfaceClient")
  occupancies     Occupancy[]
  offers          Offer[]
  workOrders      WorkOrder[]
  workEntries     WorkEntry[]
}

model AdvertisingCarrier {
  id                   String        @id @default(cuid())
  name                 String
  code                 String        @unique
  type                 CarrierType
  latitude             Float?
  longitude            Float?
  gpsStatus            GpsStatus     @default(UNVERIFIED)
  street               String?
  address              String?
  locality             String?
  city                 String
  region               String?
  cadastralArea        String?
  structureCode        String?
  mountingType         MountingType  @default(UNKNOWN)
  status               CarrierStatus @default(ACTIVE)
  description          String?
  placementDescription String?
  note                 String?
  archivedAt           DateTime?
  archivedBy           String?
  archiveReason        String?
  sourceSystem         String?
  sourceSheet          String?
  sourceRow            Int?
  sourceKey            String?       @unique
  importBatchId        String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  importBatch      ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  surfaces         AdvertisingSurface[]
  photos           Photo[]
  workItems        WorkOrderItem[]
  workTasks        WorkTask[]
  navigationPoints NavigationPoint[]

  @@index([importBatchId])
  @@index([archivedAt])
  @@index([city, structureCode])
  @@index([latitude, longitude])
}

model WorkTask {
  id                   String           @id @default(cuid())
  title                String
  description          String?
  assignedToEmployeeId String?
  createdByEmployeeId  String?
  carrierId            String?
  vehicleId            String?
  workOrderId          String?
  dueDate              DateTime?
  scheduledDate        DateTime?
  priority             WorkTaskPriority @default(NORMAL)
  status               WorkTaskStatus   @default(TODO)
  location             String?
  note                 String?
  remunerationMethod   RateType         @default(HOURLY)
  plannedQuantity      Decimal?         @db.Decimal(10, 2)
  plannedTimeHours     Decimal?         @db.Decimal(10, 2)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  assignedTo  Employee?           @relation("AssignedWorkTasks", fields: [assignedToEmployeeId], references: [id], onDelete: SetNull)
  createdBy   Employee?           @relation("CreatedWorkTasks", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)
  carrier     AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  vehicle     Vehicle?            @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  workOrder   WorkOrder?          @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  items       SettlementItem[]
  workEntries WorkEntry[]
  photos      Photo[]

  @@index([assignedToEmployeeId])
  @@index([createdByEmployeeId])
  @@index([carrierId])
  @@index([vehicleId])
  @@index([workOrderId])
  @@index([status, scheduledDate])
  @@index([priority, dueDate])
}

model Settlement {
  id                  String           @id @default(cuid())
  employeeId          String
  periodFrom          DateTime
  periodTo            DateTime
  periodYear          Int
  periodMonth         Int
  status              SettlementStatus @default(DRAFT)
  totalAmount         Decimal?         @db.Decimal(12, 2)
  totalWorkAmount     Decimal          @default(0) @db.Decimal(12, 2)
  totalReimbursements Decimal          @default(0) @db.Decimal(12, 2)
  totalDeductions     Decimal          @default(0) @db.Decimal(12, 2)
  totalAdvances       Decimal          @default(0) @db.Decimal(12, 2)
  finalPayableAmount  Decimal          @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal?         @db.Decimal(12, 2)
  paymentDate         DateTime?
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  items                 SettlementItem[]
  adjustments           SettlementAdjustment[]
  auditLogs             SettlementAuditLog[]
  invoice               Invoice?
  correctionAdjustments SettlementAdjustment[] @relation("CorrectionOriginalSettlement")

  @@unique([employeeId, periodYear, periodMonth])
  @@index([employeeId])
  @@index([status, periodFrom, periodTo])
}

model SettlementItem {
  id           String       @id @default(cuid())
  settlementId String
  taskId       String?
  workEntryId  String?      @unique
  date         DateTime
  description  String
  quantity     Decimal?     @db.Decimal(10, 2)
  unit         String?
  unitPrice    Decimal?     @db.Decimal(12, 2)
  amount       Decimal      @db.Decimal(12, 2)
  appliedRate  Decimal      @default(0) @db.Decimal(12, 2)
  rateType     RateType?
  rateSource   RateSource?
  rateId       String?
  carrierType  CarrierType?
  workType     WorkType?
  note         String?

  settlement            Settlement             @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  task                  WorkTask?              @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workEntry             WorkEntry?             @relation(fields: [workEntryId], references: [id], onDelete: Restrict)
  settlementAdjustments SettlementAdjustment[]

  @@index([settlementId])
  @@index([taskId])
  @@index([date])
}

model Vehicle {
  id                       String        @id @default(cuid())
  name                     String
  type                     VehicleType   @default(CAR)
  registrationNumber       String?
  vin                      String?
  status                   VehicleStatus @default(AVAILABLE)
  technicalInspectionUntil DateTime?
  insuranceUntil           DateTime?
  note                     String?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  reservations   VehicleReservation[]
  serviceRecords VehicleServiceRecord[]
  workTasks      WorkTask[]

  @@index([type, status])
  @@index([registrationNumber])
}

model VehicleReservation {
  id         String            @id @default(cuid())
  vehicleId  String
  employeeId String
  dateFrom   DateTime
  dateTo     DateTime
  purpose    String
  status     ReservationStatus @default(RESERVED)
  note       String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([employeeId])
  @@index([status, dateFrom, dateTo])
}

model VehicleServiceRecord {
  id              String    @id @default(cuid())
  vehicleId       String
  date            DateTime
  title           String
  description     String?
  cost            Decimal?  @db.Decimal(12, 2)
  mileage         Int?
  nextServiceDate DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@index([date])
  @@index([nextServiceDate])
}

model AdvertisingSurface {
  id                   String        @id @default(cuid())
  carrierId            String
  currentClientId      String?
  importBatchId        String?
  name                 String
  mediaType            MediaType     @default(OTHER)
  sourcePosition       String?
  directionDescription String?
  rawMediaType         String?
  sourceKey            String?       @unique
  size                 String?
  orientation          String?
  status               SurfaceStatus @default(AVAILABLE)
  price                Decimal?      @db.Decimal(12, 2)
  note                 String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  carrier       AdvertisingCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  currentClient Client?            @relation("CurrentSurfaceClient", fields: [currentClientId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  occupancies   Occupancy[]
  offerItems    OfferItem[]
  photos        Photo[]
  workItems     WorkOrderItem[]

  @@index([carrierId])
  @@index([currentClientId])
  @@index([importBatchId])
  @@index([mediaType, status])
}

model Occupancy {
  id                     String          @id @default(cuid())
  surfaceId              String
  clientId               String?
  clientName             String
  campaignName           String
  dateFrom               DateTime
  dateTo                 DateTime
  status                 OccupancyStatus @default(RESERVED)
  price                  Decimal?        @db.Decimal(12, 2)
  note                   String?
  createdBy              String?
  updatedBy              String?
  reservedUntil          DateTime?
  offerId                String?
  brandName              String?
  externalOrderReference String?
  rawSourceText          String?
  sourceSystem           String?
  sourceSheet            String?
  sourceRow              Int?
  sourceColumn           Int?
  clientResolutionStatus ClientResolutionStatus @default(RESOLVED)
  statusDerivation       String?
  sourceKey              String?         @unique
  importBatchId          String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  surface     AdvertisingSurface @relation(fields: [surfaceId], references: [id], onDelete: Cascade)
  client      Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  offer       Offer?             @relation(fields: [offerId], references: [id], onDelete: SetNull)
  importBatch ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([offerId, surfaceId])
  @@index([surfaceId])
  @@index([clientId])
  @@index([offerId])
  @@index([importBatchId])
  @@index([status, dateFrom, dateTo])
}

model Offer {
  id                    String      @id @default(cuid())
  clientId              String
  title                 String
  campaignName          String?
  pricingTier           String      @default("komerce")
  contactPerson         String?
  contactEmail          String?
  contactPhone          String?
  campaignGoal          String?
  budget                Decimal?    @db.Decimal(12, 2)
  status                OfferStatus @default(DRAFT)
  offerType             OfferType   @default(STANDARD_MEDIA)
  validUntil            DateTime?
  note                  String?
  internalNote          String?
  clientMessage         String?
  currency              String      @default("CZK")
  taxRate               Decimal     @default(21) @db.Decimal(5, 2)
  subtotal              Decimal?    @db.Decimal(12, 2)
  discountAmount        Decimal?    @db.Decimal(12, 2)
  taxAmount             Decimal?    @db.Decimal(12, 2)
  totalPrice            Decimal?    @db.Decimal(12, 2)
  totalWithTax          Decimal?    @db.Decimal(12, 2)
  publicTokenHash       String?     @unique
  publishedAt           DateTime?
  sentAt                DateTime?
  acceptedAt            DateTime?
  rejectedAt            DateTime?
  expiredAt             DateTime?
  archivedAt            DateTime?
  negotiationApprovedAt DateTime?
  createdBy             String?
  createdByUserId       String?
  updatedByUserId       String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdByUser     User?                   @relation("OfferCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUser     User?                   @relation("OfferUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  items             OfferItem[]
  occupancies       Occupancy[]
  events            OfferEvent[]
  charges           OfferCharge[]
  navigationOffer   NavigationOffer?
  cityGalleryOffer  CityGalleryOffer?
  packageSelections OfferPackageSelection[]

  @@index([clientId])
  @@index([status, validUntil])
  @@index([createdByUserId, createdAt])
  @@index([archivedAt])
}

model NavigationOffer {
  id              String   @id @default(cuid())
  offerId         String   @unique
  targetName      String
  targetAddress   String?
  targetLatitude  Float
  targetLongitude Float
  targetNote      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offer  Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  points NavigationPoint[]

  @@index([targetLatitude, targetLongitude])
}

model NavigationPoint {
  id                String                @id @default(cuid())
  navigationOfferId String
  carrierId         String?
  sortOrder         Int                   @default(0)
  latitude          Float
  longitude         Float
  address           String?
  label             String
  navigationType    String
  variant           String?
  orientation       String?
  quantity          Decimal               @default(1) @db.Decimal(10, 2)
  unitPrice         Decimal               @default(0) @db.Decimal(12, 2)
  subtotal          Decimal               @default(0) @db.Decimal(12, 2)
  installationPrice Decimal               @default(0) @db.Decimal(12, 2)
  removalPrice      Decimal               @default(0) @db.Decimal(12, 2)
  productionPrice   Decimal               @default(0) @db.Decimal(12, 2)
  internalNote      String?
  clientNote        String?
  status            NavigationPointStatus @default(PLANNED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  navigationOffer NavigationOffer     @relation(fields: [navigationOfferId], references: [id], onDelete: Cascade)
  carrier         AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)

  @@index([navigationOfferId, sortOrder])
  @@index([carrierId])
  @@index([latitude, longitude])
}

model CityGalleryProject {
  id          String                   @id @default(cuid())
  title       String
  status      CityGalleryProjectStatus @default(DRAFT)
  city        String?
  locality    String?
  address     String?
  latitude    Float?
  longitude   Float?
  description String?
  dateFrom    DateTime?
  dateTo      DateTime?
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  offers CityGalleryOffer[]

  @@index([status, city])
}

model CityGalleryOffer {
  id              String   @id @default(cuid())
  offerId         String   @unique
  projectId       String?
  concept         String?
  locationBrief   String?
  realizationNote String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offer   Offer               @relation(fields: [offerId], references: [id], onDelete: Cascade)
  project CityGalleryProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model MediaPackage {
  id              String   @id @default(cuid())
  name            String
  description     String?
  active          Boolean  @default(true)
  standardPrice   Decimal? @db.Decimal(12, 2)
  packagePrice    Decimal? @db.Decimal(12, 2)
  defaultDuration Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rules      MediaPackageRule[]
  selections OfferPackageSelection[]

  @@index([active, name])
}

model MediaPackageRule {
  id        String    @id @default(cuid())
  packageId String
  mediaType MediaType
  city      String?
  locality  String?
  quantity  Int
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  package MediaPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId, sortOrder])
  @@index([mediaType, city])
}

model OfferPackageSelection {
  id            String                    @id @default(cuid())
  offerId       String
  packageId     String?
  packageName   String
  selectionMode MediaPackageSelectionMode @default(MANUAL)
  standardPrice Decimal?                  @db.Decimal(12, 2)
  packagePrice  Decimal?                  @db.Decimal(12, 2)
  createdAt     DateTime                  @default(now())

  offer   Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  package MediaPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  items   OfferItem[]

  @@index([offerId])
  @@index([packageId])
}

model OfferPriceRule {
  id              String                @id @default(cuid())
  code            String                @unique
  category        OfferPriceCategory
  label           String
  description     String?
  mediaType       MediaType?
  calculation     OfferPriceCalculation @default(PER_SURFACE)
  unit            String
  unitPrice       Decimal               @db.Decimal(12, 2)
  defaultSelected Boolean               @default(false)
  active          Boolean               @default(true)
  sortOrder       Int                   @default(0)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  createdBy User?         @relation("OfferPriceRuleCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User?         @relation("OfferPriceRuleUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  charges   OfferCharge[]

  @@index([category, active, sortOrder])
  @@index([mediaType, active])
}

model OfferCharge {
  id          String             @id @default(cuid())
  offerId     String
  priceRuleId String?
  category    OfferPriceCategory
  code        String
  label       String
  description String?
  quantity    Decimal            @db.Decimal(10, 2)
  unit        String
  unitPrice   Decimal            @db.Decimal(12, 2)
  subtotal    Decimal            @db.Decimal(12, 2)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())

  offer     Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  priceRule OfferPriceRule? @relation(fields: [priceRuleId], references: [id], onDelete: SetNull)

  @@index([offerId, sortOrder])
  @@index([priceRuleId])
}

model OfferItem {
  id                 String   @id @default(cuid())
  offerId            String
  packageSelectionId String?
  surfaceId          String
  dateFrom           DateTime
  dateTo             DateTime
  quantity           Decimal  @default(1) @db.Decimal(10, 2)
  unit               String   @default("plocha")
  unitPrice          Decimal? @db.Decimal(12, 2)
  discountPercent    Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount     Decimal  @default(0) @db.Decimal(12, 2)
  subtotal           Decimal? @db.Decimal(12, 2)
  sortOrder          Int      @default(0)
  groupLabel         String?
  customTitle        String?
  clientDescription  String?
  price              Decimal? @db.Decimal(12, 2)
  note               String?
  createdAt          DateTime @default(now())

  offer            Offer                  @relation(fields: [offerId], references: [id], onDelete: Cascade)
  surface          AdvertisingSurface     @relation(fields: [surfaceId], references: [id], onDelete: Cascade)
  packageSelection OfferPackageSelection? @relation(fields: [packageSelectionId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([surfaceId])
  @@index([packageSelectionId])
  @@index([dateFrom, dateTo])
}

model OfferEvent {
  id          String         @id @default(cuid())
  offerId     String
  type        OfferEventType
  fromStatus  OfferStatus?
  toStatus    OfferStatus?
  actorUserId String?
  actorName   String?
  actorEmail  String?
  message     String?
  metadata    Json?
  createdAt   DateTime       @default(now())

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([offerId, createdAt])
  @@index([actorUserId])
}

model Photo {
  id              String    @id @default(cuid())
  carrierId       String?
  surfaceId       String?
  employeeId      String?
  taskId          String?
  workEntryId     String?
  url             String
  driveFileId     String?
  fileName        String?
  mimeType        String?
  size            Int?
  type            PhotoType @default(CARRIER)
  note            String?
  sortOrder       Int       @default(0)
  isPrimary       Boolean   @default(false)
  isClientVisible Boolean   @default(false)
  isPrivate       Boolean   @default(false)
  createdAt       DateTime  @default(now())

  carrier   AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  surface   AdvertisingSurface? @relation(fields: [surfaceId], references: [id], onDelete: Cascade)
  employee  Employee?           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  task      WorkTask?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workEntry WorkEntry?          @relation(fields: [workEntryId], references: [id], onDelete: SetNull)

  @@unique([carrierId, driveFileId])
  @@index([carrierId])
  @@index([carrierId, sortOrder])
  @@index([surfaceId])
  @@index([employeeId])
}

model ImportBatch {
  id           String       @id @default(cuid())
  fileName     String
  sourceType   String
  status       ImportStatus @default(DRAFT)
  totalRows    Int          @default(0)
  validRows    Int          @default(0)
  importedRows Int          @default(0)
  skippedRows  Int          @default(0)
  errorRows    Int          @default(0)
  mapping      Json?
  fileHash     String?
  reportPath   String?
  environment  String?
  createdById  String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy      User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  carriers       AdvertisingCarrier[]
  surfaces       AdvertisingSurface[]
  occupancies    Occupancy[]
  priceListItems PriceListItem[]
  errors         ImportRowError[]

  @@index([createdById])
  @@index([status, createdAt])
  @@index([fileHash])
}

model PriceListItem {
  id              String       @id @default(cuid())
  identityKey     String
  versionKey      String       @unique
  name            String
  carrierType     CarrierType?
  mediaType       MediaType?
  rentalMonths    Int          @default(1)
  minQuantity     Int          @default(1)
  rentalPrice     Decimal      @db.Decimal(12, 2)
  productionPrice Decimal      @db.Decimal(12, 2)
  totalPrice      Decimal      @db.Decimal(12, 2)
  currency        String       @default("CZK")
  validFrom       DateTime
  validTo         DateTime?
  isActive        Boolean      @default(true)
  sourceSheet     String?
  sourceRow       Int?
  importBatchId   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@index([identityKey, validFrom, validTo])
  @@index([isActive])
  @@index([importBatchId])
}

model ImportRowError {
  id        String   @id @default(cuid())
  batchId   String
  rowNumber Int
  sheetName String?
  field     String?
  code      String
  message   String
  rawData   Json
  createdAt DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
}

model WorkOrder {
  id               String          @id @default(cuid())
  title            String
  description      String
  status           WorkOrderStatus @default(NEW)
  priority         WorkPriority    @default(NORMAL)
  workType         WorkType        @default(OTHER)
  scheduledAt      DateTime
  deadlineAt       DateTime?
  campaignDateFrom DateTime?
  campaignDateTo   DateTime?
  clientId         String?
  clientName       String
  requestedBy      String?
  contactName      String?
  contactPhone     String?
  locationNote     String?
  mediaLabel       String?
  quantity         Int?
  price            Decimal?        @db.Decimal(12, 2)
  referenceUrl     String?
  ftdUrl           String?
  ftdSent          Boolean         @default(false)
  invoiced         Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  client      Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  assignments WorkAssignment[]
  items       WorkOrderItem[]
  workTasks   WorkTask[]
  workEntries WorkEntry[]
  rates       WorkOrderRate[]

  @@index([scheduledAt, status])
  @@index([priority, scheduledAt])
  @@index([clientId])
}

model WorkAssignment {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String?
  workerName  String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([userId])
}

model WorkOrderItem {
  id          String   @id @default(cuid())
  workOrderId String
  carrierId   String?
  surfaceId   String?
  description String?
  quantity    Int      @default(1)
  createdAt   DateTime @default(now())

  workOrder WorkOrder           @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  carrier   AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  surface   AdvertisingSurface? @relation(fields: [surfaceId], references: [id], onDelete: SetNull)

  @@index([workOrderId])
  @@index([carrierId])
  @@index([surfaceId])
}

enum WorkEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

enum WorkEntryCreationSource {
  AUTOMATIC
  MANUAL
}

enum RateSource {
  EMPLOYEE_RATE
  WORK_ORDER_RATE
  COMPANY_RATE
  MANUAL
}

model WorkOrderRate {
  id              String       @id @default(cuid())
  workOrderId     String
  type            RateType
  name            String
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("CZK")
  unit            String?
  workType        WorkType?
  carrierType     CarrierType?
  validFrom       DateTime
  validTo         DateTime?
  note            String?
  isActive        Boolean      @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([type, workType, validFrom])
  @@index([isActive, validFrom, validTo])
}

model CompanyRate {
  id              String       @id @default(cuid())
  type            RateType
  name            String
  amount          Decimal      @db.Decimal(12, 2)
  currency        String       @default("CZK")
  unit            String?
  workType        WorkType?
  carrierType     CarrierType?
  validFrom       DateTime
  validTo         DateTime?
  note            String?
  isActive        Boolean      @default(true)
  createdByUserId String?
  updatedByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([type, workType, validFrom])
  @@index([isActive, validFrom, validTo])
}

model WorkEntry {
  id                 String                  @id @default(cuid())
  employeeId         String
  workDate           DateTime
  workTaskId         String
  workOrderId        String?
  clientId           String?
  clientName         String?
  workType           WorkType
  carrierType        CarrierType?
  remunerationMethod RateType
  quantity           Decimal                 @db.Decimal(10, 4)
  unit               String
  appliedUnitRate    Decimal?                @db.Decimal(12, 2)
  calculatedAmount   Decimal                 @db.Decimal(12, 2)
  rateSource         RateSource?
  note               String?
  status             WorkEntryStatus         @default(DRAFT)
  creationSource     WorkEntryCreationSource @default(MANUAL)
  timeFrom           DateTime?
  timeTo             DateTime?
  rejectionReason    String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  employee              Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workTask              WorkTask               @relation(fields: [workTaskId], references: [id], onDelete: Restrict)
  workOrder             WorkOrder?             @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  client                Client?                @relation(fields: [clientId], references: [id], onDelete: SetNull)
  settlementItem        SettlementItem?
  photos                Photo[]
  expenses              WorkExpense[]
  settlementAdjustments SettlementAdjustment[]

  @@index([employeeId])
  @@index([workTaskId])
  @@index([workOrderId])
  @@index([status])
  @@index([workDate])
}

enum ExpenseType {
  FUEL
  PARKING
  PURCHASE
  OTHER
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdjustmentType {
  REIMBURSEMENT
  BONUS
  CARRY_OVER_ADD
  ADVANCE
  DEDUCTION
  CARRY_OVER_SUB
}

enum AdjustmentCategory {
  PHONE
  RENT
  PARKING
  FUEL
  PURCHASE
  PENALTY
  OTHER
}

model WorkExpense {
  id               String        @id @default(cuid())
  workEntryId      String
  type             ExpenseType
  description      String
  amount           Decimal       @db.Decimal(12, 2)
  receiptPhotoId   String?
  status           ExpenseStatus @default(PENDING)
  approvedByUserId String?
  approvedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  workEntry   WorkEntry              @relation(fields: [workEntryId], references: [id], onDelete: Restrict)
  adjustments SettlementAdjustment[]
}

model RecurringAdjustment {
  id          String             @id @default(cuid())
  employeeId  String
  type        AdjustmentType
  category    AdjustmentCategory
  description String
  amount      Decimal            @db.Decimal(12, 2)
  validFrom   DateTime
  validTo     DateTime?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  employee    Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  adjustments SettlementAdjustment[]

  @@index([employeeId])
}

model SettlementAdjustment {
  id                             String             @id @default(cuid())
  settlementId                   String
  recurringAdjustmentId          String?
  workExpenseId                  String?            @unique
  correctionWorkEntryId          String?
  correctionSettlementItemId     String?
  correctionOriginalSettlementId String?
  correctionKey                  String?            @unique
  type                           AdjustmentType
  category                       AdjustmentCategory
  description                    String
  amount                         Decimal            @db.Decimal(12, 2)
  note                           String?
  reason                         String? // Reason for manually overriding or adding/deleting
  changedByUserId                String?
  previousEffectiveAmount        Decimal?           @db.Decimal(12, 2)
  correctedEffectiveAmount       Decimal?           @db.Decimal(12, 2)
  correctedQuantity              Decimal?           @db.Decimal(10, 2)
  correctedUnitRate              Decimal?           @db.Decimal(12, 2)
  correctedNote                  String?
  createdAt                      DateTime           @default(now())
  updatedAt                      DateTime           @updatedAt

  settlement                   Settlement           @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  recurringAdjustment          RecurringAdjustment? @relation(fields: [recurringAdjustmentId], references: [id], onDelete: SetNull)
  workExpense                  WorkExpense?         @relation(fields: [workExpenseId], references: [id], onDelete: Restrict)
  correctionWorkEntry          WorkEntry?           @relation(fields: [correctionWorkEntryId], references: [id], onDelete: Restrict)
  correctionSettlementItem     SettlementItem?      @relation(fields: [correctionSettlementItemId], references: [id], onDelete: Restrict)
  correctionOriginalSettlement Settlement?          @relation("CorrectionOriginalSettlement", fields: [correctionOriginalSettlementId], references: [id], onDelete: Restrict)

  @@unique([settlementId, recurringAdjustmentId])
  @@index([settlementId])
  @@index([recurringAdjustmentId])
  @@index([workExpenseId])
}

model SystemSettings {
  id          String   @id @default("default")
  companyName String   @default("SeePoint s.r.o.")
  companyId   String?
  vatId       String?
  street      String?
  city        String?
  postalCode  String?
  country     String?
  bankAccount String?
  iban        String?
  swift       String?
  updatedAt   DateTime @updatedAt
}

model SettlementAuditLog {
  id           String   @id @default(cuid())
  settlementId String
  userId       String
  userName     String
  action       String // e.g. "ITEM_UPDATE", "ITEM_DELETE", "ADJUSTMENT_ADD", "STATUS_CHANGE"
  fieldName    String? // e.g. "amount", "unitPrice", "quantity", "status"
  oldValue     String?
  newValue     String?
  reason       String
  createdAt    DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

model Invoice {
  id            String        @id @default(cuid())
  settlementId  String        @unique
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)

  // Date details:
  issueDate  DateTime
  dueDate    DateTime
  periodFrom DateTime
  periodTo   DateTime

  // Supplier details snapshot (Worker):
  supplierName     String
  supplierIco      String?
  supplierDic      String?
  supplierAddress  String
  supplierAccount  String?
  supplierIban     String?
  supplierSwift    String?
  supplierVatPayer Boolean @default(false)

  // Customer details snapshot (Company):
  customerName    String
  customerIco     String?
  customerDic     String?
  customerAddress String
  customerAccount String?
  customerIban    String?
  customerSwift   String?

  totalAmount Decimal @db.Decimal(12, 2)
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  grossAmount Decimal @db.Decimal(12, 2)
  note        String?
  pdfUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  settlement Settlement    @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  items      InvoiceItem[]
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(10, 2)
  unit        String
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  vatRate     Decimal @default(0) @db.Decimal(5, 2)
  vatAmount   Decimal @default(0) @db.Decimal(12, 2)
  totalAmount Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}
