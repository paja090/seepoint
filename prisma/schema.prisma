generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  TECHNICIAN
  VIEWER
}

enum CarrierType {
  BILLBOARD
  BIGBOARD
  CITYLIGHT
  BANNER
  FACADE
  LED_SCREEN
  PROMO_BENCH
  PROMO_HORIZON
  CITY_POSTER
  NAVIGATION
  PROMO_TOWER
  PROMO_MINITOWER
  OTHER
}

enum CarrierStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum GpsStatus {
  MISSING
  UNVERIFIED
  VERIFIED
}

enum MountingType {
  LIGHT_POLE
  POLE
  COLUMN
  TRACTION
  OTHER
  UNKNOWN
}

enum MediaType {
  NAVIGATION_SIGN
  BILLBOARD
  BIGBOARD
  CITYLIGHT
  BANNER
  FACADE
  LED_SCREEN
  PROMO_BENCH
  PROMO_HORIZON
  CITY_POSTER
  PROMO_TOWER
  PROMO_MINITOWER
  OTHER
}

enum SurfaceStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  NEGOTIATION
  OUT_OF_SERVICE
}

enum OccupancyStatus {
  RESERVED
  ACTIVE
  FINISHED
  CANCELLED
}

enum PhotoType {
  LOCATION
  CARRIER
  CAMPAIGN
  INSTALLATION
  CHECK
  ARCHIVE
}

enum ImportStatus {
  DRAFT
  VALIDATED
  IMPORTED
  FAILED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  importBatches ImportBatch[]
}

model Client {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  externalCode   String?  @unique
  note           String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  currentSurfaces AdvertisingSurface[] @relation("CurrentSurfaceClient")
  occupancies     Occupancy[]
}

model AdvertisingCarrier {
  id              String        @id @default(cuid())
  name            String
  code            String        @unique
  type            CarrierType
  latitude        Float?
  longitude       Float?
  gpsStatus       GpsStatus     @default(UNVERIFIED)
  address         String?
  city            String
  region          String?
  cadastralArea   String?
  structureCode   String?
  mountingType    MountingType  @default(UNKNOWN)
  status          CarrierStatus @default(ACTIVE)
  note            String?
  sourceSystem    String?
  sourceSheet     String?
  sourceRow       Int?
  sourceKey       String?       @unique
  importBatchId   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  importBatch ImportBatch?         @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  surfaces    AdvertisingSurface[]
  photos      Photo[]

  @@index([importBatchId])
  @@index([city, structureCode])
  @@index([latitude, longitude])
}

model AdvertisingSurface {
  id                   String        @id @default(cuid())
  carrierId            String
  currentClientId      String?
  importBatchId        String?
  name                 String
  mediaType            MediaType     @default(OTHER)
  sourcePosition       String?
  directionDescription String?
  rawMediaType         String?
  sourceKey            String?       @unique
  size                 String?
  orientation          String?
  status               SurfaceStatus @default(AVAILABLE)
  price                Decimal?      @db.Decimal(12, 2)
  note                 String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  carrier       AdvertisingCarrier @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  currentClient Client?            @relation("CurrentSurfaceClient", fields: [currentClientId], references: [id], onDelete: SetNull)
  importBatch   ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  occupancies   Occupancy[]
  photos        Photo[]

  @@index([carrierId])
  @@index([currentClientId])
  @@index([importBatchId])
  @@index([mediaType, status])
}

model Occupancy {
  id           String          @id @default(cuid())
  surfaceId    String
  clientId     String?
  clientName   String
  campaignName String
  dateFrom     DateTime
  dateTo       DateTime
  status       OccupancyStatus @default(RESERVED)
  price        Decimal?        @db.Decimal(12, 2)
  note         String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  surface AdvertisingSurface @relation(fields: [surfaceId], references: [id], onDelete: Cascade)
  client  Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([surfaceId])
  @@index([clientId])
}

model Photo {
  id          String    @id @default(cuid())
  carrierId   String?
  surfaceId   String?
  url         String
  driveFileId String?   @unique
  fileName    String?
  mimeType    String?
  size        Int?
  type        PhotoType @default(CARRIER)
  note        String?
  createdAt   DateTime  @default(now())

  carrier AdvertisingCarrier? @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  surface AdvertisingSurface? @relation(fields: [surfaceId], references: [id], onDelete: Cascade)

  @@index([carrierId])
  @@index([surfaceId])
}

model ImportBatch {
  id           String       @id @default(cuid())
  fileName     String
  sourceType   String
  status       ImportStatus @default(DRAFT)
  totalRows    Int          @default(0)
  validRows    Int          @default(0)
  importedRows Int          @default(0)
  skippedRows  Int          @default(0)
  errorRows    Int          @default(0)
  mapping      Json?
  createdById  String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  createdBy User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  carriers  AdvertisingCarrier[]
  surfaces  AdvertisingSurface[]
  errors    ImportRowError[]

  @@index([createdById])
  @@index([status, createdAt])
}

model ImportRowError {
  id        String   @id @default(cuid())
  batchId   String
  rowNumber Int
  sheetName String?
  field     String?
  code      String
  message   String
  rawData   Json
  createdAt DateTime @default(now())

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, rowNumber])
}
