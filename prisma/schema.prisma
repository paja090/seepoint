model NavigationOrder {
  id                 String                 @id @default(cuid())
  crmOrderId         String                 @unique
  status             NavigationOrderStatus  @default(POPTAVKA)
  blockStatus        NavigationBlockStatus?
  rentStart          DateTime?
  rentEnd            DateTime?
  installationDate   DateTime?
  deinstallationDate DateTime?

  targetName      String
  targetAddress   String?
  targetLatitude  Float
  targetLongitude Float
  targetNote      String?

  graphicsApprovedAt DateTime?
  productionReadyAt  DateTime?
  installedAt        DateTime?
  invoicedAt         DateTime?

  plannedInstallationAt DateTime?
  installerUserId       String?
  qcStatus              String?   @default("PENDING")
  qcApprovedAt          DateTime?
  qcApprovedUserId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crmOrder            CrmOrder                  @relation(fields: [crmOrderId], references: [id], onDelete: Cascade)
  installerUser       User?                     @relation("NavOrderInstaller", fields: [installerUserId], references: [id], onDelete: SetNull)
  points              NavigationPoint[]
  billingPeriods      NavigationBillingPeriod[]
  navigationContracts NavigationContract[]
  workOrders          WorkOrder[]
  surveyRoutes        SurveyRoute[]
  candidatePoints     NavigationCandidatePoint[]

  @@index([status])
}

model SurveyRoute {
  id                String          @id @default(cuid())
  navigationOrderId String
  name              String
  description       String?
  originName        String?
  originLatitude    Float?
  originLongitude   Float?
  targetLatitude    Float?
  targetLongitude   Float?
  routeOrder        Int             @default(0)
  active            Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  navigationOrder NavigationOrder          @relation(fields: [navigationOrderId], references: [id], onDelete: Cascade)
  candidatePoints NavigationCandidatePoint[]

  @@index([navigationOrderId, active, routeOrder])
}

model NavigationCandidatePoint {
  id                         String                     @id @default(cuid())
  navigationOrderId          String
  surveyRouteId              String?
  label                      String
  latitude                   Float
  longitude                  Float
  address                    String?
  campaignType               String?                    @default("Dlouhodobá navigace")
  placementType              CarrierType                @default(NAVIGATION)
  approachDirection          String?
  arrowDirection             NavigationArrowDirection?  @default(STRAIGHT)
  distanceValue              Decimal?                   @db.Decimal(10, 2)
  distanceUnit               DistanceUnit               @default(KILOMETERS)
  distanceSource             NavigationDistanceSource   @default(CALCULATED)
  ownershipType              CandidateOwnershipType     @default(UNKNOWN)
  ownerName                  String?
  visibilityTowardTarget    CandidateVisibilityQuality @default(GOOD)
  permitStatus               CandidatePermitStatus      @default(UNKNOWN)
  internalNote               String?
  createdByUserId            String
  assignedToUserId           String?
  surveyStatus               CandidateSurveyStatus      @default(COMPLETED)
  supervisionStatus          CandidateSupervisionStatus @default(PENDING_REVIEW)
  supervisionNote            String?
  supervisionByUserId        String?
  supervisionAt              DateTime?
  selectedForOffer           Boolean                    @default(false)
  rejectionReason            String?
  carrierId                  String?
  surfaceId                  String?
  convertedNavigationPointId String?                    @unique
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  navigationOrder          NavigationOrder          @relation(fields: [navigationOrderId], references: [id], onDelete: Cascade)
  surveyRoute              SurveyRoute?             @relation(fields: [surveyRouteId], references: [id], onDelete: SetNull)
  createdByUser            User                     @relation("CandidateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  assignedToUser           User?                    @relation("CandidateAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  supervisionByUser        User?                    @relation("CandidateSupervisionBy", fields: [supervisionByUserId], references: [id], onDelete: SetNull)
  carrier                  AdvertisingCarrier?      @relation(fields: [carrierId], references: [id], onDelete: SetNull)
  surface                  AdvertisingSurface?      @relation(fields: [surfaceId], references: [id], onDelete: SetNull)
  convertedNavigationPoint NavigationPoint?         @relation("CandidateConvertedPoint", fields: [convertedNavigationPointId], references: [id], onDelete: SetNull)
  photos                   Photo[]                  @relation("CandidatePhotos")

  @@index([navigationOrderId, supervisionStatus])
  @@index([surveyRouteId])
  @@index([createdByUserId])
  @@index([latitude, longitude])
}

model NavigationBillingPeriod {
  id                String              @id @default(cuid())
  navigationOrderId String
  dateFrom          DateTime
  dateTo            DateTime
  invoiceId         String?             @unique
  status            ClientInvoiceStatus @default(DRAFT)
  amount            Decimal             @db.Decimal(12, 2)
  invoicedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  navigationOrder NavigationOrder @relation(fields: [navigationOrderId], references: [id], onDelete: Cascade)
  invoice         ClientInvoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([navigationOrderId, dateFrom, dateTo])
  @@index([navigationOrderId])
}

model NavigationPriceVersion {
  id                String    @id @default(cuid())
  navigationPointId String
  validFrom         DateTime
  validTo           DateTime?
  unitPrice         Decimal   @db.Decimal(12, 2)
  installationPrice Decimal   @default(0) @db.Decimal(12, 2)
  removalPrice      Decimal   @default(0) @db.Decimal(12, 2)
  productionPrice   Decimal   @default(0) @db.Decimal(12, 2)
  subtotal          Decimal   @db.Decimal(12, 2)
  reason            String?
  changedByUserId   String?
  createdAt         DateTime  @default(now())

  navigationPoint NavigationPoint @relation(fields: [navigationPointId], references: [id], onDelete: Cascade)
  changedByUser   User?           @relation("NavigationPriceChangedUser", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([navigationPointId, validFrom])
}

model NavigationPriceAuditLog {
  id                String   @id @default(cuid())
  navigationPointId String
  oldUnitPrice      Decimal? @db.Decimal(12, 2)
  newUnitPrice      Decimal  @db.Decimal(12, 2)
  effectiveDate     DateTime
  reason            String
  changedByUserId   String
  changedByUserName String
  createdAt         DateTime @default(now())

  navigationPoint NavigationPoint @relation(fields: [navigationPointId], references: [id], onDelete: Cascade)
  changedByUser   User            @relation("NavigationPriceAuditUser", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([navigationPointId])
}

model NavigationContract {
  id                String   @id @default(cuid())
  contractNumber    String   @unique
  contractType      String   @default("RENTAL") // RENTAL, PRODUCTION, SERVICE, MASTER
  clientId          String
  agencyName        String?
  responsiblePerson String?
  phone             String?
  email             String?
  offerId           String?
  navigationOrderId String?
  startDate         DateTime
  endDate           DateTime
  monthlyPrice      Decimal? @db.Decimal(12, 2)
  totalPrice        Decimal? @db.Decimal(12, 2)
  status            String   @default("ACTIVE") // DRAFT, ACTIVE, EXPIRING, EXPIRED, TERMINATED
  autoRenews        Boolean  @default(false)
  alertDaysBefore   Int      @default(30)
  note              String?
  fileUrl           String?
  fileName          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client          Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer           Offer?               @relation(fields: [offerId], references: [id], onDelete: SetNull)
  navigationOrder NavigationOrder?     @relation(fields: [navigationOrderId], references: [id], onDelete: SetNull)
  surfaces        AdvertisingSurface[]

  @@index([clientId])
  @@index([startDate, endDate])
  @@index([status])
}

model NavigationContactPerson {
  id          String   @id @default(cuid())
  clientId    String
  contactType String   @default("CLIENT") // CLIENT, AGENCY, RESPONSIBLE_PERSON
  name        String
  agencyName  String?
  role        String?
  phone       String?
  email       String?
  isPrimary   Boolean  @default(false)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model CarrierHistoryLog {
  id          String   @id @default(cuid())
  carrierId   String
  surfaceId   String?
  eventType   String // INSTALLATION, REINSTALLATION, GRAPHICS_CHANGE, REPAIR, SERVICE, DEINSTALLATION, CLIENT_CHANGE, RENTAL_CHANGE
  title       String
  description String?
  performedBy String?
  performedAt DateTime @default(now())
  clientId    String?
  clientName  String?
  photoUrl    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  carrier AdvertisingCarrier  @relation(fields: [carrierId], references: [id], onDelete: Cascade)
  surface AdvertisingSurface? @relation(fields: [surfaceId], references: [id], onDelete: SetNull)

  @@index([carrierId, performedAt])
  @@index([eventType])
}

enum ShoppingPriority {
  NORMAL
  THIS_WEEK
  URGENT
}

model CompanyShoppingItem {
  id                   String           @id @default(cuid())
  category             String // "OFFICE" (Kancelář) or "WORKSHOP" (Dílna & Výroba)
  title                String
  quantity             String?
  unit                 String?
  store                String?
  priority             ShoppingPriority @default(NORMAL)
  note                 String?
  imageUrl             String?
  receiptUrl           String?
  isPurchased          Boolean          @default(false)
  assignedEmployeeId   String?
  assignedEmployeeName String?
  crmOrderId           String?
  crmOrder             CrmOrder?        @relation(fields: [crmOrderId], references: [id], onDelete: SetNull)
  addedByUserId        String?
  addedByUserName      String
  purchasedByUserId    String?
  purchasedByUserName  String?
  purchasedAt          DateTime?
  pricePaid            Decimal?         @db.Decimal(10, 2)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([category])
  @@index([isPurchased])
  @@index([priority])
  @@index([assignedEmployeeId])
  @@index([crmOrderId])
}

enum WarehouseItemCategory {
  CONSUMABLE
  RETURNABLE
}

enum WarehouseMovementType {
  RECEIPT
  ISSUE
  RETURN
  ADJUSTMENT
}

model WarehouseItem {
  id              String                @id @default(cuid())
  name            String
  code            String?
  category        WarehouseItemCategory @default(CONSUMABLE)
  unit            String                @default("ks")
  quantityInStock Decimal               @default(0) @db.Decimal(10, 2)
  minQuantity     Decimal?              @db.Decimal(10, 2)
  unitPrice       Decimal?              @db.Decimal(10, 2)
  location        String?
  supplierName    String?
  supplierContact String?
  photoUrl        String?
  note            String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  movements WarehouseMovement[]

  @@index([category])
  @@index([location])
}

model WarehouseMovement {
  id                   String                @id @default(cuid())
  itemId               String
  item                 WarehouseItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type                 WarehouseMovementType
  quantity             Decimal               @db.Decimal(10, 2)
  workOrderId          String?
  workOrder            WorkOrder?            @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  assignedEmployeeId   String?
  assignedEmployeeName String?
  performedByName      String
  note                 String?
  createdAt            DateTime              @default(now())

  @@index([itemId])
  @@index([workOrderId])
  @@index([assignedEmployeeId])
}

enum QuickInternalTaskStatus {
  PENDING
  COMPLETED
  UNRESOLVED
}

model QuickInternalTask {
  id                   String                  @id @default(cuid())
  title                String
  description          String?
  assignedToEmployeeId String
  createdByUserId      String
  dueDate              DateTime?
  priority             String                  @default("MEDIUM")
  status               QuickInternalTaskStatus @default(PENDING)
  unresolvedReason     String?
  completedAt          DateTime?
  completionNote       String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  assignedToEmployee Employee @relation("AssignedQuickTasks", fields: [assignedToEmployeeId], references: [id], onDelete: Cascade)
  createdByUser      User     @relation("CreatedQuickTasks", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([assignedToEmployeeId, status])
  @@index([createdByUserId])
}

