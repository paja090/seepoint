{
  "name": "seepoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:migrate:deploy": "prisma migrate deploy",
    "start": "next start",
    "lint": "eslint .",
    "test": "npx tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "seed:demo-settlement": "npx tsx scripts/seed-demo-settlement.ts",
    "seed:demo-settlement:clean": "npx tsx scripts/seed-demo-settlement.ts --clean",
    "offer:demo-pdf": "node --experimental-strip-types scripts/generate-demo-offer-pdf.ts",
    "import:carriers-2026": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/import-carriers-2026.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "pdfmake": "^0.3.11",
    "prisma": "^6.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  }
}
